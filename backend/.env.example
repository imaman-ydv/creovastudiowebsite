DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Set DB_ENGINE=postgresql and provide these for a shared production database.
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Contact inquiry notifications (SMTP credentials belong in local .env/deployment secrets)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=studiocreova@gmail.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=studiocreova@gmail.com
CONTACT_NOTIFICATION_EMAIL=studiocreova@gmail.com
